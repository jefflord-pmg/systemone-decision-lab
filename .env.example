# ---------------------------------------------------------------- decision backend
# Which backend `start-model.sh` serves. One command starts whichever is selected:
#   strands     - the original local model (below); this is the default
#   opendecider - an OpenDecider model served locally, e.g. opendecider-nano
#   lmstudio    - an OpenDecider model loaded in LM Studio (see README)
DECIDER_BACKEND=strands

# OpenDecider / LM Studio settings (used only when DECIDER_BACKEND != strands).
# The app and compare_backends.py call DECIDER_API_ENDPOINT; the launcher binds
# DECIDER_API_PORT. Keep them on the same port.
DECIDER_API_PORT=8001
DECIDER_API_ENDPOINT=http://127.0.0.1:8001/v1/systemone
# Optional overrides of the backend preset's model/device shown in the dashboard.
# DECIDER_API_MODEL=manjunathshiva/opendecider-nano
# DECIDER_API_DEVICE=auto

# LM Studio backend only (DECIDER_BACKEND=lmstudio).
LMSTUDIO_URL=http://10.0.0.177:1234/v1
LMSTUDIO_MODEL=opendecider-small

# ---------------------------------------------------------------- strands backend
# Hugging Face model id or local checkpoint path served by strands-decider.
DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# Inference device passed to `strands-decider serve --device`: cpu, cuda, mps.
# Keep cpu unless GPU inference has been verified on this machine.
DECIDER_DEVICE=cpu

# Where the model server listens (the pool proxy when DECIDER_POOL_SIZE > 1).
DECIDER_HOST=127.0.0.1
DECIDER_PORT=8000

# Independent model-server processes. Each loads its own copy of the model, so 2-4
# can raise throughput when several decisions run at once (needs enough GPU memory).
# 1 = a single server, started directly on DECIDER_PORT.
DECIDER_POOL_SIZE=1

# Full SystemOne endpoint the Streamlit app calls. /health is derived from it.
DECIDER_ENDPOINT=http://127.0.0.1:8000/v1/systemone

# Max questions per forward pass. Server warm-up runs every batch size up to this,
# so a small value keeps CPU startup short.
DECIDER_MAX_BATCH=8

# Set to 1 to skip server warm-up (faster startup, slower first requests).
DECIDER_NO_WARMUP=0

# Seconds the Streamlit app waits for a decision before giving up.
DECIDER_TIMEOUT=180
